// Windguru Wind-Dashboard — Datenmodell.
//
// Alles hängt am Spot. Ein Snapshot = ein Datenabruf für einen Spot zu einem Zeitpunkt. Die
// eigentlichen Zeitreihen liegen je Modell-Reihe genau einmal als JSON in ModelRun; welcher
// Abruf welche Reihen sah, steht in SnapshotRun. Geschrieben wird ausschließlich von den
// Databricks-Jobs (scripts/ingest_job.py, scripts/skill_job.py), die App liest nur.

generator client {
  provider   = "prisma-client-js"
  // engineType "client" = Rust-freier Client OHNE Query-Engine-Binary (nutzt den WASM-
  // Query-Compiler über den pg-Treiber-Adapter) — klein genug für Vercel-Funktionen; die
  // .wasm nimmt next.config.ts ins File-Tracing auf. Siehe prisma.ts.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ein Spot (Windguru id_spot). Fix eingetragen per Seed (Brouwersdam 97, Mirns 3642).
model Spot {
  id        Int          @id // = Windguru id_spot
  slug      String       @unique
  name      String
  region    String?
  lat       Float?
  lon       Float?
  sortOrder Int          @default(0)

  // Laufzeit-Konfiguration für den Lern-Job (scripts/skill_job.py). Gespiegelt aus
  // config/spots.json durch scripts/seed-spots.mjs — damit die Python-Seite keine eigene Spot-Tabelle braucht.
  //   stations   = [{ id, name, source }]  — die AKTUELL gültigen Messstationen
  //   waterCodes = ["code", …]             — Rijkswaterstaat-Stellen, die ERSTE ist Referenz
  stations   Json?
  waterCodes Json?

  snapshots Snapshot[]
  runs      ModelRun[]
  stationObs StationObs[]
  updatedAt DateTime     @updatedAt
}

// Messung einer Wetterstation am Spot (config/spots.json → stations). Windguru-Stationen
// liefern 10-min-Mittel; der Erfassungs-Job holt bei jedem Lauf die letzten Stunden nach, so
// füllen sich Lücken durch ausgefallene Läufe von selbst. soarcast (Mirns NKV) kennt keinen
// Verlauf — dort nur der jeweils aktuelle Wert. Werte in Knoten / °C.
model StationObs {
  id        String   @id @default(cuid())
  spotId    Int
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  stationId Int      // id der Quelle (Windguru id_station bzw. soarcast location_id)
  obsTime   DateTime // Zeitpunkt der Messung
  fetchedAt DateTime @default(now())

  windAvg   Float? // kn
  windMax   Float? // kn (Böe)
  windMin   Float? // kn
  windDir   Float? // Grad
  temp      Float? // °C

  // Ein Spot kann mehrere Messstationen haben — je Station und Messzeitpunkt genau eine Zeile.
  @@unique([spotId, stationId, obsTime])
  @@index([spotId, obsTime])
}

// Ein Datenabruf für einen Spot. Trägt die zum Abrufzeitpunkt gültigen Spot-Metadaten und
// die Blend-Definition von Windguru (Modellgewichte etc.) als JSON.
model Snapshot {
  id        String        @id @default(cuid())
  spotId    Int
  spot      Spot          @relation(fields: [spotId], references: [id], onDelete: Cascade)
  fetchedAt DateTime      @default(now())
  ok        Boolean       @default(true)

  // Spot-Meta zum Abrufzeitpunkt (aus dem forecast_spot-Header extrahiert).
  sunrise   String?
  sunset    String?
  waterTemp Float?
  timezone  String?

  // Windguru-Blend-Konfiguration (model_koef, mix_range, Sensitivitäten) als JSON.
  blend     Json?

  runs      SnapshotRun[]
  models    ModelSeries[] // ALT, s. u.

  @@index([spotId, fetchedAt])
}

// Eine Modell-Zeitreihe, GENAU EINMAL gespeichert. Windguru setzt eine Reihe oft aus mehreren
// Läufen zusammen (ECMWF: 18z für 0–144 h + 12z für 156–360 h); `rundef` beschreibt diese
// Zusammensetzung und ist deshalb der Schlüssel für „dieselbe Reihe". Früher stand jede Reihe
// in jedem 30-min-Abruf erneut (≈ 7× dieselben Daten); jetzt verweist der Abruf per SnapshotRun
// auf sie. Der Erfassungs-Job lädt eine bekannte `rundef` gar nicht erst neu herunter.
model ModelRun {
  id            String   @id @default(cuid())
  spotId        Int
  spot          Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  idModel       Int
  // Windguru-Laufbeschreibung, z. B. "2026092418x0x144x0x144-2026092412x0x360x156x360".
  // Aus der alten Tabelle übernommene Reihen tragen "legacy:<md5 der Reihe>".
  rundef        String
  modelName     String
  modelLongname String?
  resolution    Float? // km — kleiner = höher aufgelöst = relevanter für lokale Küste
  initStamp     Int // Unix-Sekunden des jüngsten beteiligten Laufs (init)

  // Zeitreihe als JSON:
  // { times:[unix], WINDSPD:[kn], GUST:[kn], WINDDIR:[deg], TMP:[°C], TMPE:[°C],
  //   TCDC/HCDC/MCDC/LCDC:[%], APCP1:[mm], RH:[%], SLP:[hPa] }
  series        Json
  firstSeen     DateTime @default(now())

  snapshots     SnapshotRun[]

  @@unique([spotId, idModel, rundef])
  @@index([spotId, idModel, initStamp])
}

// Welche Modell-Reihen ein Abruf gesehen hat (n:m). `koef` = Gewicht im Windguru-Blend zum
// Abrufzeitpunkt (gehört zum Abruf, nicht zur Reihe).
model SnapshotRun {
  snapshotId String
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  runId      String
  run        ModelRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  koef       Float    @default(1)

  @@id([snapshotId, runId])
  @@index([runId])
}

// ALT — bis zur Umstellung aller Leser/Schreiber noch vorhanden, danach per
// `node scripts/migrate-runs.mjs --drop-legacy` gelöscht (siehe DATABRICKS.md). Nicht mehr
// beschreiben oder lesen.
model ModelSeries {
  id            String   @id @default(cuid())
  snapshotId    String
  snapshot      Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  idModel       Int
  modelName     String
  modelLongname String?
  resolution    Float?
  koef          Float    @default(1)
  initStamp     Int
  series        Json

  @@index([snapshotId])
  @@index([idModel])
}

// Materialisierte Modell-Güte je Spot × Modell: recency-gewichteter Vergleich der
// Modellvorhersage gegen die Messung. Geschrieben vom Lern-Job (scripts/skill_job.py).
model ModelSkill {
  id         String   @id @default(cuid())
  spotId     Int
  idModel    Int
  label      String
  resolution Float?
  mae        Float? // recency-gewichteter mittlerer abs. Fehler (kn)
  bias       Float? // recency-gewichteter Bias, Prognose − Messung (kn)
  samples    Float    @default(0) // effektive (recency-gewichtete) Stichprobenzahl
  score      Float    @default(0) // Konsens-Gewicht 1/σ² (Vorlauf 0–24 h, gewählte Variante) — Anzeige
  updatedAt  DateTime @updatedAt

  @@unique([spotId, idModel])
  @@index([spotId])
}

// Materialisierte Ergebnisse je Spot, stündlich erneuert vom Lern-Job (scripts/skill_job.py):
//  - verification: rollierende, ehrliche Verifikation (Varianten, Brier, Nowcast-Nachlauf)
//  - params: gelerntes Nachkorrektur-Modell (calib.ts SpotParams) — speist den Konsens
model SpotStat {
  spotId       Int      @id
  verification Json? // serialisiertes Verification-Objekt
  params       Json? // SpotParams: Variante, Fits je Modell × Vorlauf, sigmaScale, nowcastGain
  updatedAt    DateTime @updatedAt
}

// Gemessene Wassertemperatur (Rijkswaterstaat, DDAPI20) je Messstelle. Vom Erfassungs-Job
// bei jedem Lauf abgerufen (neuester Wert je Stelle; mehrere Sensoren gemittelt). Speist die
// Anzeige und den Schichtungs-Term (Wasser − Luft) der Nachkorrektur.
model WaterTemp {
  id        String   @id @default(cuid())
  spotId    Int
  code      String // Rijkswaterstaat-Locatiecode, z. B. "friesekust.ijsselmeer"
  obsTime   DateTime
  value     Float // °C
  fetchedAt DateTime @default(now())

  @@unique([code, obsTime])
  @@index([spotId, obsTime])
}
