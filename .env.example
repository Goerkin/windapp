# --- Datenbank ---
# Lokale Entwicklung: lokale Postgres. Auf Vercel: Lakebase (siehe README).
DATABASE_URL="postgresql://user:password@localhost:5432/windguru?schema=public"

# --- Laufzeit-Schalter ---
# WIND_DB=lakebase             -> DB über pg-Adapter mit Lakebase-Token-Erneuerung (Vercel)
WIND_DB=""

# --- Datenerfassung & Lernen ---
# Beides läuft NICHT in der App, sondern als Databricks-Jobs (scripts/ingest_job.py,
# scripts/skill_job.py). Lokal lassen sich beide direkt gegen DATABASE_URL ausführen:
#   DATABASE_URL=... LAKEBASE_SCHEMA=public python3 scripts/ingest_job.py
#   DATABASE_URL=... LAKEBASE_SCHEMA=public python3 scripts/skill_job.py
# Optionale Stellschrauben des Lern-Jobs: SKILL_WINDOW_DAYS (90), SKILL_HALFLIFE_DAYS (14),
# SKILL_MAX_SNAPS (200), SKILL_NOW (Unix-Sek., nur für reproduzierbare Tests).

# --- Lakebase / Databricks (nur mit WIND_DB=lakebase bzw. für Skripte; lokal leer lassen) ---
DATABRICKS_HOST=""          # z. B. https://dbc-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=""         # PAT/User-Token (Skripte); Vercel nutzt DATABRICKS_CLIENT_ID/SECRET
LAKEBASE_PROJECT="windguru"
LAKEBASE_BRANCH="production"
LAKEBASE_SCHEMA="windguru"
